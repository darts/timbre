{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Timbre",
  "version": "0.1.0",
  "identifier": "com.timbre.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Timbre",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 640,
        "decorations": true,
        "transparent": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$HOME/Library/Application Support/timbre/clips/**",
          "$HOME/Library/Application Support/timbre/voices/**",
          "$HOME/Library/Application Support/timbre/recordings/**",
          "$CONFIG/timbre/clips/**",
          "$CONFIG/timbre/voices/**",
          "$CONFIG/timbre/recordings/**",
          "$APPDATA/timbre/clips/**",
          "$APPDATA/timbre/voices/**",
          "$APPDATA/timbre/recordings/**",
          "$DATA/timbre/clips/**",
          "$DATA/timbre/voices/**",
          "$DATA/timbre/recordings/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "msi", "nsis", "deb", "appimage", "rpm"],
    "resources": {
      "../py/pyproject.toml": "py/pyproject.toml",
      "../py/timbre/*.py": "py/timbre/",
      "../py/timbre/adapters/*.py": "py/timbre/adapters/",
      "../py/requirements/*.txt": "py/requirements/",
      "../resources/*.json": "resources/"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0",
      "entitlements": "entitlements.plist"
    },
    "windows": {
      "wix": { "language": "en-US" },
      "nsis": { "displayLanguageSelector": false }
    },
    "linux": {
      "deb": {
        "depends": ["libwebkit2gtk-4.1-0", "libsoup-3.0-0", "libssl3", "libgtk-3-0"]
      },
      "rpm": {
        "depends": ["webkit2gtk4.1", "libsoup3", "openssl", "gtk3"]
      }
    }
  }
}
