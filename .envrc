# Loaded by direnv. Requires nix-direnv: https://github.com/nix-community/nix-direnv
# After cloning, run `direnv allow` once.
use flake

# Pick up local overrides (never commit .env)
dotenv_if_exists .env

# Re-run the bootstrap below whenever any of these change.
watch_file pnpm-lock.yaml
watch_file py/requirements/base.txt
watch_file py/pyproject.toml

# --- Idempotent dependency bootstrap ----------------------------------------
# Keeps node_modules and py/.venv in sync with the lockfiles. No-op when
# nothing has changed (cheap enough to run on every direnv reload).

stamp_dir=".direnv/bootstrap"
mkdir -p "$stamp_dir"

# Node deps
node_stamp="$stamp_dir/pnpm-lock.sha"
node_hash="$(shasum -a 256 pnpm-lock.yaml | awk '{print $1}')"
if [ ! -d node_modules ] || [ "$(cat "$node_stamp" 2>/dev/null || true)" != "$node_hash" ]; then
  echo "  pnpm   ↻ installing…"
  pnpm install --frozen-lockfile
  echo "$node_hash" > "$node_stamp"
else
  echo "  pnpm   ✓ up to date"
fi

# Python deps: lightweight project venv (no torch — runtime backend pack
# handles cpu/cuda/mps wheels in the user's app-data dir).
venv="py/.venv"
py_stamp="$stamp_dir/py-deps.sha"
py_hash="$(cat py/requirements/base.txt py/pyproject.toml | shasum -a 256 | awk '{print $1}')"

if [ ! -x "$venv/bin/python" ]; then
  uv venv "$venv" --python python3.12
  : > "$py_stamp"
fi

if [ "$(cat "$py_stamp" 2>/dev/null || true)" != "$py_hash" ]; then
  echo "  python ↻ installing…"
  uv pip install --python "$venv/bin/python" -r py/requirements/base.txt
  uv pip install --python "$venv/bin/python" -e ./py
  echo "$py_hash" > "$py_stamp"
else
  echo "  python ✓ up to date"
fi

export VIRTUAL_ENV="$PWD/$venv"
PATH_add "$venv/bin"
